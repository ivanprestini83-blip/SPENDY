# Copiare questo file in `.env.local` (gia' ignorato da git grazie a *.local)
# e incollare i due valori presi da Supabase:
#   Project Settings -> API -> Project URL / anon public
#
# La chiave `service_role` NON va mai messa qui ne' in nessun file del
# frontend: finirebbe nel bundle servito al browser.
#
# Senza queste variabili l'app funziona lo stesso, tutta in locale, senza
# login e senza sincronizzazione.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
